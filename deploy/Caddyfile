# HTTPS in front of the board with automatic Let's Encrypt certificates.
# Point a DNS A record (e.g. sports.example.com) at your VPS, then:
#   sudo apt install caddy && sudo cp deploy/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy
sports.example.com {
	encode gzip
	reverse_proxy 127.0.0.1:8080
}
